{
  "version": 2,
  "builds": [
    {
      "src": "src/app.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/app.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/confirmation",
      "schedule": "0 2 * * *"
    },
    { "path": "/api/cron/sla", "schedule": "0 3 * * *" }
  ]
}
